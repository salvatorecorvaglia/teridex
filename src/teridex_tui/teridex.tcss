/* Teridex Textual CSS — main layout
 *
 * Layout:
 *   ┌── Data Catalog ────┐┌──── Query Editor ──────────────────┐
 *   │ schema tree         ││  Tab 1  Tab 2                     │
 *   │                     ││  SQL editor with line numbers      │
 *   │                     │├───────────────────────────────────┤
 *   │                     ││ Tx: Auto   Limit 500  [Run Query] │
 *   │                     │├──── Query Results ────────────────┤
 *   │                     ││  data table                       │
 *   └─────────────────────┘└───────────────────────────────────┘
 *   ^q Quit  f1 Help  ^↵ Run Query  ^r Refresh  ... (footer)
 */

Screen {
    background: $background;
    color: $foreground;
}

/* ── Top-level wrapper ── */
MainScreen {
    height: 100%;
    width: 100%;
    layout: vertical;
}

/* ── 2-column grid: sidebar | workspace ── */
#main-grid {
    layout: grid;
    grid-size: 2 1;
    grid-columns: 28 1fr;
    grid-rows: 1fr;
    height: 1fr;
    width: 100%;
}

/* Dynamic plugin rails (preserve existing behaviour) */
#main-grid.with-right {
    grid-size: 3 1;
    grid-columns: 28 1fr auto;
}

/* ── Sidebar: "Data Catalog" ── */
#sidebar {
    border: round $primary;
    border-title-align: left;
    border-title-color: $foreground;
    border-title-style: bold;
    padding: 0 1;
    overflow-y: auto;
}

/* ── Right workspace ── */
#workspace {
    layout: vertical;
    height: 100%;
}

/* ── Query Editor panel ── */
#editor-panel {
    border: round $primary;
    border-title-align: left;
    border-title-color: $foreground;
    border-title-style: bold;
    height: 2fr;
    min-height: 8;
}

/* ── Action bar between editor and results ── */
#action-bar {
    height: 1;
    background: $surface;
    layout: horizontal;
    padding: 0 1;
}

#action-bar .action-label {
    width: auto;
    color: $foreground;
    padding: 0 1;
}

#action-bar #run-query-btn {
    dock: right;
    min-width: 14;
    background: $primary;
    color: $background;
    text-style: bold;
    padding: 0 1;
}

/* ── Query Results panel ── */
#results-panel {
    border: round $primary;
    border-title-align: left;
    border-title-color: $foreground;
    border-title-style: bold;
    height: 1fr;
    min-height: 4;
}

/* ── Plugin rails ── */
#right-rail {
    width: 30;
    border: round $primary 50%;
    padding: 0 1;
}

#bottom-rail {
    column-span: 2;
    height: 10;
    border-top: solid $primary 50%;
    padding: 0 1;
}

#main-grid.with-right #bottom-rail {
    column-span: 3;
}

/* ── Footer status bar — yellow/gold with keybinding shortcuts ── */
#status-bar {
    height: 1;
    background: $warning;
    color: $background;
    padding: 0 1;
    text-style: bold;
    dock: bottom;
    width: 100%;
}

/* ── Widget-level styles ── */

SchemaTree {
    height: 100%;
}

/* TabbedContent inside the editor panel */
#query-tabs {
    height: 100%;
}

SqlEditor {
    height: 100%;
}

ResultsTable {
    height: 100%;
}

/* ── Command Palette overlay ── */
CommandPalette {
    layer: overlay;
    align: center top;
    width: 70%;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1;
    margin-top: 4;
}

#palette-input {
    height: 3;
    border: round $primary;
}

#palette-list {
    height: 12;
    border: round $primary;
}

/* ── Help, History & Connection modals ── */
#HelpModal,
#HistoryModal,
#ConnectionModal {
    align: center middle;
    background: $surface;
    border: thick $accent;
    width: 80%;
    max-width: 100;
    height: 60%;
    max-height: 28;
    padding: 1 2;
}

#history-list {
    height: 1fr;
    border: round $primary;
}

#conn-input {
    height: 3;
    border: round $primary;
    margin-bottom: 1;
}

#conn-presets {
    height: 6;
    border: round $primary;
    margin-bottom: 1;
    background: $surface;
}

#conn-submit-btn {
    dock: bottom;
    min-width: 14;
    background: $primary;
    color: $background;
    text-style: bold;
}
