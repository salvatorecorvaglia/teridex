/* Teridex Textual CSS — base layout */

Screen {
    background: $background;
    color: $foreground;
}

/* Default layout: 2 columns × 3 rows
 *   [ sidebar  | workspace ]
 *   [ sidebar  | workspace ]
 *   [ status-bar (spans 2) ]
 *
 * Plugin rails (#right-rail, #bottom-rail) are mounted dynamically.
 * When they appear, the host adds the .with-right / .with-bottom
 * classes to #main-grid to extend the grid geometry.
 */
#main-grid {
    layout: grid;
    grid-size: 2 3;
    grid-columns: 28 1fr;
    grid-rows: 1fr 1fr 1;
    height: 100%;
    width: 100%;
}

#main-grid.with-right {
    grid-size: 3 3;
    grid-columns: 28 1fr auto;
}

#main-grid.with-bottom {
    grid-size: 2 4;
    grid-rows: 1fr 1fr auto 1;
}

#main-grid.with-right.with-bottom {
    grid-size: 3 4;
    grid-columns: 28 1fr auto;
    grid-rows: 1fr 1fr auto 1;
}

#sidebar {
    row-span: 2;
    border: round $primary;
    padding: 0 1;
    overflow-y: auto;
}

#workspace {
    row-span: 2;
    layout: vertical;
    border: round $primary;
}

#right-rail {
    row-span: 2;
    width: 30;
    border: round $primary 50%;
    padding: 0 1;
}

#bottom-rail {
    column-span: 3;
    height: 10;
    border-top: solid $primary 50%;
    padding: 0 1;
}

#tabs {
    height: 1;
    background: $boost;
}

#editor-area {
    height: 40%;
    border-bottom: solid $primary;
}

#results-area {
    height: 1fr;
}

#status-bar {
    column-span: 3;
    height: 1;
    background: $accent;
    color: $background;
    padding: 0 1;
}

SchemaTree {
    height: 100%;
}

SqlEditor {
    height: 100%;
}

ResultsTable {
    height: 100%;
    border-bottom: solid $primary 30%;
}

CommandPalette {
    layer: overlay;
    align: center top;
    width: 70%;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1;
    margin-top: 4;
}

#palette-input {
    height: 3;
    border: round $primary;
}

#palette-list {
    height: 12;
    border: round $primary;
}

#HelpModal,
#HistoryModal {
    align: center middle;
    background: $surface;
    border: thick $accent;
    width: 80%;
    max-width: 100;
    height: 60%;
    max-height: 28;
    padding: 1 2;
}

#history-list {
    height: 1fr;
    border: round $primary;
}
