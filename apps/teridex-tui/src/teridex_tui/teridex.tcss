/* Teridex Textual CSS — base layout */

Screen {
    background: $background;
    color: $foreground;
}

#main-grid {
    layout: grid;
    /* 3 columns × 3 rows:
     *   [ sidebar  | workspace | right-rail ]
     *   [ sidebar  | workspace | right-rail ]
     *   [ bottom-rail (spans all)           ]
     *   [ status-bar (spans all)            ]
     */
    grid-size: 3 4;
    grid-columns: 28 1fr auto;
    grid-rows: 1fr 1fr auto 1;
    height: 100%;
    width: 100%;
}

#sidebar {
    row-span: 2;
    border: round $primary;
    padding: 0 1;
    overflow-y: auto;
}

#workspace {
    row-span: 2;
    layout: vertical;
    border: round $primary;
}

#right-rail {
    row-span: 2;
    width: auto;
    min-width: 0;
    border: round $primary 30%;
    display: none;       /* hidden until the app mounts at least one panel */
}

#right-rail.has-panels {
    display: block;
    min-width: 24;
}

#bottom-rail {
    column-span: 3;
    height: auto;
    border-top: solid $primary 30%;
    display: none;
}

#bottom-rail.has-panels {
    display: block;
    height: 10;
}

#tabs {
    height: 1;
    background: $boost;
}

#editor-area {
    height: 40%;
    border-bottom: solid $primary;
}

#results-area {
    height: 1fr;
}

#status-bar {
    column-span: 3;
    height: 1;
    background: $accent;
    color: $background;
    padding: 0 1;
}

SchemaTree {
    height: 100%;
}

SqlEditor {
    height: 100%;
}

ResultsTable {
    height: 100%;
}

CommandPalette {
    layer: overlay;
    align: center top;
    width: 70%;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1;
    margin-top: 4;
}

#palette-input {
    height: 3;
    border: round $primary;
}

#palette-list {
    height: 12;
    border: round $primary;
}

#HelpModal,
#HistoryModal {
    align: center middle;
    background: $surface;
    border: thick $accent;
    width: 70;
    height: 22;
    padding: 1 2;
}

#history-list {
    height: 14;
    border: round $primary;
}
